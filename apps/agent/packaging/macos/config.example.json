{
  "remote_control_enabled": true,
  "long_task_restart_enabled": false,
  "darkbloom_binary": "~/.darkbloom/bin/darkbloom",
  "collection_enabled": true,
  "device_state_enabled": true,
  "provider_state_file": "~/.darkbloom/daemon-state.json",
  "data_dir": "~/Library/Application Support/Bloomer/agent",
  "log_dir": "~/Library/Logs/Bloomer/agent",
  "listen": "127.0.0.1:17890",
  "upstream_url": "https://api.darkbloom.dev/v1/provider/account-earnings",
  "upstream_credential_file": "~/.darkbloom/auth_token",
  "access_token_file": "~/Library/Application Support/Bloomer/agent/access.token",
  "network_rates": {
    "enabled": true,
    "interval_minutes": 2,
    "window_samples": 5,
    "auto_switch": false,
    "switch_min_interval_minutes": 30,
    "switch_advantage_ratio": 0.2,
    "fallback_model": "gemma-4-26b-qat-4bit",
    "chip_families": ["M4", "M5", "M6"],
    "chip_tiers": ["Pro"],
    "memory_gb": 64,
    "min_providers": 3,
    "near_zero_micro_usd_per_hour": 1000
  },
  "alert": {
    "enabled": false,
    "bark_key_file": "~/Library/Application Support/Bloomer/agent/bark.key",
    "bark_server": "https://api.day.app",
    "bind_interface": "en1",
    "repeat_minutes": 30,
    "dashboard_url": ""
  }
}
